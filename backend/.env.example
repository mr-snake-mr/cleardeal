APP_NAME=ClearDeal
APP_VERSION=0.1.0
DEBUG=false

# SQLite in development. Postgres in production: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./cleardeal.db

# JSON array of allowed browser origins
ALLOWED_ORIGINS=["http://localhost:5173"]

# PayPal ? never commit real values
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Model B only: AES-GCM key for stored merchant credentials. 32 random bytes,
# hex-encoded. Absent = credential endpoints return 503 rather than storing
# plaintext.
CREDENTIALS_ENCRYPTION_KEY=
# Signs session cookies. Absent/development value refuses to boot outside debug.
SESSION_SECRET=
