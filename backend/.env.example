# Copy to .env and fill in. Never commit .env.

APP_NAME=ClearDeal
DEBUG=false
DATABASE_URL=sqlite:///./cleardeal.db

# CORS. Comma-separated exact origins. Empty in production, because the SPA is
# served from the same origin as the API.
ALLOWED_ORIGINS=http://localhost:5173

# PayPal is per-tenant (Model B): each freelancer supplies their own
# client_id/secret via PUT /api/v1/merchants/paypal. There is deliberately no
# global credential here - a platform-wide key would make the platform, not the
# freelancer, the merchant.
PAYPAL_ENV=sandbox

# Model B only: AES-GCM key for stored merchant credentials. 32 bytes as 64 hex
# characters (or 44-character base64). Absent = credential endpoints return 503
# rather than storing plaintext.
CREDENTIALS_ENCRYPTION_KEY=

# Signs session cookies. The development default refuses to boot outside debug.
SESSION_SECRET=
